# Copy to .env and fill in what you use. Everything here is optional —
# the simulator runs standalone with none of these set.

# Langfuse tracing for simulated inference requests (see api/langfuse_client.py).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Encryption key for locally-stored, bring-your-own AI provider API keys
# (see api/ai_settings_db.py). Required before you can save a provider key
# in the AI settings panel. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_SETTINGS_SECRET=
